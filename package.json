{
  "name": "secure-bucket-cdk",
  "version": "1.0.0",
  "description": "CDK Construct for secure S3 bucket with GitHub OIDC",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "deploy:dev": "cdk deploy --context environment=dev",
    "deploy:prod": "cdk deploy --context environment=prod",
    "diff": "cdk diff",
    "lint": "eslint lib/ bin/ test/ --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "20.6.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "aws-cdk": "2.96.2",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2"
  },
  "dependencies": {
    "aws-cdk-lib": "2.96.2",
    "constructs": "^10.0.0"
  },
  "keywords": [
    "aws",
    "cdk",
    "s3",
    "oidc",
    "github-actions"
  ],
  "author": "DevOps Engineer",
  "license": "MIT"
}
